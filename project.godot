[internationalization]

pseudolocalization/replace_with_accents=false
pseudolocalization/double_vowels=true

[layer_names]

2d_physics/layer_1="terrain_a"
2d_physics/layer_2="terrain_b"
2d_physics/layer_3="enemies"
2d_physics/layer_4="editor_objects"
2d_physics/layer_5="player"
2d_physics/layer_6="editor_polygons"
2d_physics/layer_7="monitors"
2d_physics/layer_8="solid_bouncables"

[physics]

common/physics_ticks_per_second=180
common/max_physics_steps_per_frame=24

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
