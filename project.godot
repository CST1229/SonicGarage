; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sonic Garage"
config/description="A dumb Sonic Studio recreation"
config/version="0.0.3"
run/main_scene="uid://c1m2cm6yym2j5"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/use_filter=false
boot_splash/image="uid://bdhdmiina8pem"
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="uid://bvsmik2x1ye3e"

[autoload]

Settings="*res://scripts/Settings.gd"
Global="*res://scripts/Global.gd"
EditorLib="*res://scripts/EditorLib.gd"
GlobalSounds="*res://scripts/GlobalSounds.gd"
LevelDrawing="*res://scripts/LevelDrawing/LevelDrawing.gd"
LevelUtil="*res://scripts/LevelUtil.gd"
Music="*res://scripts/Music.gd"
Fades="*res://scripts/Fades.gd"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/unsafe_cast=1

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/initial_position_type=5
window/size/window_width_override=854
window/size/window_height_override=480
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"
window/stretch/scale_mode="integer"

[editor]

script/templates_search_path="res://scripts/templates"
naming/scene_name_casing=1
naming/script_name_casing=1

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
theme/custom="uid://dsc2sl34kqmp"
theme/custom_font="uid://bwoa021kuhdit"

